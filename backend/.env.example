# ============================================================
# HoneyChain Backend — Environment Variables Example
# ============================================================
# Copy this file to .env for local development and populate values.
# NEVER commit .env or any file with real credentials.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/honeychain_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# For Docker Compose, use the service name: jdbc:mysql://mysql:3306/honeychain_db?...
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=com.mysql.cj.jdbc.Driver

# --- JWT ---
# Must be a strong secret (min 256-bit / 64 hex chars). Do NOT commit real value.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS & Frontend URL ---
# Must match exactly the URL the frontend is served from (no trailing slash).
# Used for both CORS and QR code URL generation.
FRONTEND_PUBLIC_URL=http://localhost:5173
# Production example: FRONTEND_PUBLIC_URL=https://honeychain.example.com

# --- File Storage ---
# Directory for uploaded files (QR codes, photos). Mount this as a Docker volume.
UPLOAD_DIRECTORY=uploads

# --- Mock / Abstraction Service Flags ---
# BLOCKCHAIN_MODE: 'mock' for demo; replace with 'real' when integrating live chain
BLOCKCHAIN_MODE=mock
# IOT_MOCK_ENABLED: true runs simulated sensor data; false requires real hardware
IOT_MOCK_ENABLED=true
# NOTIFICATION_SMS_ENABLED: false uses in-app mock; true requires real SMS provider config
NOTIFICATION_SMS_ENABLED=false

# --- Demo Data ---
# Set to true to seed demo accounts/data on startup (hackathon/demo only)
DEMO_DATA_ENABLED=false

# --- AI Yield Prediction ---
# Max age (hours) before a yield prediction is considered stale and regenerated
AI_PREDICTION_MAX_AGE=24

# --- Spring Profile ---
# 'dev' = H2 fallback + verbose logging; 'prod' = MySQL + minimal logging
SPRING_PROFILES_ACTIVE=dev

# --- Anti-Counterfeit ---
# Salt used for fingerprinting verification scans. Change in production.
VERIFICATION_FINGERPRINT_SALT=honeychain-secure-salt-2026
