# ============================================================
# HoneyChain Frontend — Environment Variables Example
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.

# --- Local Development ---
# Leave VITE_API_BASE_URL unset (or empty) to use Vite's built-in proxy.
# The proxy forwards /api/* → http://localhost:8080/api/*
VITE_API_BASE_URL=

# --- Production / Docker Deployment ---
# Set this to your PUBLICLY REACHABLE backend URL (as seen from the user's browser).
# Example: VITE_API_BASE_URL=https://api.honeychain.example.com
# Do NOT use Docker service names here (e.g. http://backend:8080) — the browser
# cannot resolve internal Docker service hostnames.
