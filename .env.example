# ============================================================
# HoneyChain — Docker Compose Root .env Example
# ============================================================
# Copy to .env and populate before running: docker compose up -d
# NEVER commit .env with real credentials.

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
DB_USERNAME=
DB_PASSWORD=

# ── JWT ────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── URLs ───────────────────────────────────────────────────
# The publicly reachable frontend URL (used for CORS and QR code generation)
FRONTEND_PUBLIC_URL=http://localhost

# The publicly reachable backend URL (baked into the frontend JS bundle at build time)
# For local Docker: http://localhost:8080
# For deployed: https://api.honeychain.example.com
VITE_API_BASE_URL=http://localhost:8080

# ── Mock Services (HACKATHON MVP — clearly marked as simulated) ────────
BLOCKCHAIN_MODE=mock
IOT_MOCK_ENABLED=true
NOTIFICATION_SMS_ENABLED=false

# ── Demo Data ──────────────────────────────────────────────
# Set to true to seed demo accounts on first startup
DEMO_DATA_ENABLED=false

# ── AI ─────────────────────────────────────────────────────
AI_PREDICTION_MAX_AGE=24

# ── Security ───────────────────────────────────────────────
VERIFICATION_FINGERPRINT_SALT=honeychain-secure-salt-2026
